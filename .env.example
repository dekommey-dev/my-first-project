# ── Backend ────────────────────────────────────────────────
# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# Leave empty to run the server in DEMO mode (no key required, canned replies).
ANTHROPIC_API_KEY=

# Default model used when the client does not specify one.
DEFAULT_MODEL=claude-opus-5

# Port the API server listens on.
PORT=8787

# Comma-separated list of allowed browser origins. "*" allows any.
CORS_ORIGIN=*

# Where the SQLite database file lives.
DATA_DIR=./data

# ── Frontend (build time) ──────────────────────────────────
# Base URL of the API server. Empty = same origin (/api proxied by nginx or Vite).
VITE_API_BASE_URL=
